FROM golang:1.25-bookworm AS builder-base

# Install build dependencies for CGO (required by go-rapidsnark).
# `apt-get upgrade` pulls patched libc/curl/etc. on every build to clear
# Aikido findings against the bookworm baseline.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    build-essential \
    libgmp-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# --- Dev build: includes mock auth for testing ---
FROM builder-base AS builder-dev
RUN CGO_ENABLED=1 GOOS=linux go build -tags mockauth -o /app/bin/privacy-proxy ./cmd/server

# --- Production build: no mock auth, no dev shortcuts ---
FROM builder-base AS builder-prod
RUN CGO_ENABLED=1 GOOS=linux go build -tags production -o /app/bin/privacy-proxy ./cmd/server

# --- Runtime base (shared) ---
FROM debian:bookworm-slim AS runtime-base

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    postgresql-client \
    libgmp10 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -u 1000 -m appuser

WORKDIR /app
EXPOSE 8080

USER appuser

CMD ["./privacy-proxy"]

# --- Dev target ---
FROM runtime-base AS dev
COPY --from=builder-dev /app/bin/privacy-proxy .

# --- Prod target (default) ---
FROM runtime-base AS prod
COPY --from=builder-prod /app/bin/privacy-proxy .
