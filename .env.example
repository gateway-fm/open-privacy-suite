# Port overrides (useful when default ports are in use)
# POSTGRES_HOST_PORT=5433
# BACKEND_HOST_PORT=8081

# Backend configuration
# BASE_URL=http://localhost:8080

# Demo mode settings (development only)
# DEMO_AUTO_AUTH_DELAY=3

# Azure AD / Microsoft Entra ID authentication (optional)
# Register an app at https://portal.azure.com → Microsoft Entra ID → App registrations
# Redirect URI to add: http://localhost:5173/auth/azure/callback
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=common
